# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user/chat ID. Only this ID can control the bot.
TELEGRAM_ALLOWED_USER_ID=

# Backblaze B2 -> App Keys (S3-compatible credentials)
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_BUCKET=tiktok-live-recordings
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=
# Presigned download URL lifetime, in seconds (max practical value depends on your use)
B2_LINK_EXPIRY_SECONDS=604800

# Monitoring
POLL_INTERVAL_SECONDS=45
# A stream must be observed offline this many times before stopping a recording.
OFFLINE_CONFIRMATIONS=2
# Directory with enough free disk space for temporary recordings.
RECORDINGS_DIR=./recordings
# Max concurrent recordings. Keep low on small VPS instances.
MAX_CONCURRENT_RECORDINGS=2
# Optional path; leave as ffmpeg if installed in PATH.
FFMPEG_PATH=ffmpeg
# Optional: prefix used for object keys in the bucket.
B2_PREFIX=live-recordings
